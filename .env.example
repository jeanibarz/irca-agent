# ===========================================
# IRCA-Agent Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# ------------------------------------------
# HuggingFace Hub (required for model/dataset access)
# ------------------------------------------
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ------------------------------------------
# Argilla (optional, for dataset curation)
# ------------------------------------------
ARGILLA_API_URL=http://localhost:6900
ARGILLA_API_KEY=your_argilla_api_key_here

# ------------------------------------------
# Weights & Biases (optional, for experiment tracking)
# ------------------------------------------
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=irca-agent
WANDB_ENTITY=your_wandb_entity_here

# ------------------------------------------
# OpenAI (optional, for GPT-based generation)
# ------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------
# Paths (override defaults if needed)
# ------------------------------------------
# WORKSPACE_DIR=/workspace
# MODELS_DIR=models
# DATASETS_DIR=datasets
