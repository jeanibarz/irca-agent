{
  "experiment_id": "exp001-augmentation-impact",
  "description": "Measure impact of data augmentation (translation, shuffling) on model performance",
  "created_at": "2026-01-17",
  "hypothesis": "Augmented training data improves model robustness without significantly harming performance on original test distribution",

  "datasets": {
    "train_baseline": {
      "path": "experiments/exp001-augmentation-impact/train_formatted",
      "samples": 152,
      "augmented": false,
      "description": "Training data formatted without augmentation"
    },
    "train_augmented": {
      "path": "experiments/exp001-augmentation-impact/train_augmented",
      "samples": 436,
      "augmented": true,
      "augmentation_config": "configs/format_full_augment.json",
      "description": "Training data with 3x multiplication, translation (fr/es), shuffling"
    },
    "test": {
      "path": "experiments/exp001-augmentation-impact/test_formatted",
      "samples": 38,
      "augmented": false,
      "description": "Held-out test set for evaluation"
    }
  },

  "models_to_train": {
    "baseline": {
      "train_data": "train_baseline",
      "base_model": "mistralai/Ministral-3-3B-Instruct-2512",
      "output_dir": "experiments/exp001-augmentation-impact/models/baseline",
      "description": "Model trained on non-augmented data"
    },
    "augmented": {
      "train_data": "train_augmented",
      "base_model": "mistralai/Ministral-3-3B-Instruct-2512",
      "output_dir": "experiments/exp001-augmentation-impact/models/augmented",
      "description": "Model trained on augmented data"
    }
  },

  "evaluations": [
    {
      "name": "E1_baseline_on_test",
      "model": "baseline",
      "test_data": "test",
      "description": "Baseline model on original test set"
    },
    {
      "name": "E2_augmented_on_test",
      "model": "augmented",
      "test_data": "test",
      "description": "Augmented model on original test set"
    }
  ],

  "metrics": [
    "completion_perplexity_mean",
    "completion_perplexity_std",
    "completion_perplexity_median"
  ],

  "statistical_analysis": {
    "test": "bootstrap_paired",
    "confidence_level": 0.95,
    "n_bootstrap": 1000
  },

  "success_criteria": {
    "augmented_not_worse": "E2 perplexity <= E1 perplexity + 10%",
    "augmented_better": "E2 perplexity < E1 perplexity with p < 0.05"
  }
}
